NODE_ENV=development
LOG_LEVEL=debug

# API Gateway
GATEWAY_PORT=3000
GATEWAY_REST_PATH=api

# Auth
AUTH_PORT=3001
AUTH_DB_URL=postgresql://postgres:postgres@localhost:5432/saas
AUTH_JWT_SECRET=dev-secret-key-minimum-32-characters-long

# User
USER_PORT=3002
USER_DB_URL=postgresql://postgres:postgres@localhost:5432/saas

# Notification
NOTIFICATION_PORT=3003

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=saas-dev
KAFKA_GROUP_ID=saas-dev-group

# Web
PUBLIC_WEB_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:3000
