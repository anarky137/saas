# ==========================================
# Common
# ==========================================
NODE_ENV=development
LOG_LEVEL=info

# ==========================================
# Database
# ==========================================
DB_TYPE=typeorm

# ==========================================
# API Gateway
# ==========================================
GATEWAY_PORT=3000
GATEWAY_REST_PATH=/api
GATEWAY_GRAPHQL_PATH=/graphql

# ==========================================
# Auth Service
# ==========================================
AUTH_PORT=3001
AUTH_DB_URL=postgresql://postgres:postgres@localhost:5432/auth_db
AUTH_JWT_SECRET=your-super-secret-jwt-key-min-32-chars
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# User Service
# ==========================================
USER_PORT=3002
USER_DB_URL=postgresql://postgres:postgres@localhost:5432/user_db

# ==========================================
# Notification Service
# ==========================================
NOTIFICATION_PORT=3003

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# Kafka
# ==========================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=saas-app
KAFKA_GROUP_ID=saas-group

# ==========================================
# Web App
# ==========================================
WEB_PORT=4200
PUBLIC_WEB_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:3000
